# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/whatsapp_crm_saas

# JWT Secret (generate a long random string)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Twilio (Master account - used to provision sub-numbers)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# App URL (your public domain for webhook URLs)
APP_URL=https://your-domain.com

# Super Admin credentials (for platform owner)
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=changeme123

# Follow-up (hours of inactivity)
FOLLOWUP_INACTIVE_HOURS=24
